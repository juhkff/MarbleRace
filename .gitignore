# Unreal Engine generated files
Binaries/
DerivedDataCache/
Intermediate/
Saved/
# 本地角色名单和其他运行时存档
*.sav
.vs/

# 编辑器打开材质预览时自动写入的光照配置，每台机器都会改。
Config/DefaultEditor.ini

# 建模模式布尔、圆柱等临时网格。正式网格另存在 Content/Meshes。
Content/**/_GENERATED/

# IDE and editor files
.idea/
.vscode/
*.sln
*.slnx
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# Build outputs
Build/

# OS-generated files
.DS_Store
Thumbs.db

# 本地 MCP 调试请求与 Windows 工具缓存
/inited.json
/list.json
/%SystemDrive%/

# 可替换的本地主题素材；仓库只保留框架、材质和通用名单模板。
/Content/GGST/Portraits/
/Content/GGST/Music/
/SourceAssets/GGST/
/Config/GGST/
/Config/Roster/local_roster.json
/Config/Roster/local_music_levels.json
/Content/LocalMedia/
/SourceAssets/LocalMedia/

# 可选录制工具，按 Tools/FFmpeg/README.md 单独安装。
/Tools/FFmpeg/*.exe
